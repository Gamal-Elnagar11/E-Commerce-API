    <RootNamespace>E_Commerce_API</RootNamespace>
    <UserSecretsId>629cf437-1518-4b6a-a7d3-3285891e3309</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
